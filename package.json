{
  "name": "sunpharma-pn0510-dashboard",
  "version": "1.0.0",
  "private": true,
  "description": "Client-facing project management dashboard for the Sun Pharma PN0510 Advisory Board programme (Sun Pharma × OneAlphaMed), backed by a live Google Sheet.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch --clear-screen=false server/src/index.ts",
    "dev:client": "vite",
    "build": "vite build && node scripts/build-server.mjs",
    "build:vercel": "node scripts/build-vercel.mjs",
    "start": "node dist/server/index.js",
    "import": "tsx server/scripts/import-checklist.ts",
    "sheet:push": "tsx server/scripts/push-to-sheet.ts",
    "user:add": "tsx server/scripts/add-user.ts",
    "user:json": "node scripts/users-json.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "google-auth-library": "^9.15.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "esbuild": "^0.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vercel": "^39.3.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
