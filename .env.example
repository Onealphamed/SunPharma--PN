# ---- Server ----
PORT=8080
NODE_ENV=development
# Time zone used to decide "today" for overdue / days-remaining calculations
PROJECT_TIME_ZONE=Asia/Kolkata

# ---- Data source ----
# local  = data/local-store.json (created by `npm run import`), for development / demo
# google = live Google Sheet (production source of truth)
DATA_SOURCE=local
LOCAL_STORE_PATH=data/local-store.json
# How often the server polls the source for changes (seconds, minimum 10)
SYNC_INTERVAL_SECONDS=30

# ---- Google Sheets (required when DATA_SOURCE=google) ----
# The ID from the sheet URL: https://docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEET_ID=
# Service-account key: either the raw JSON, or base64 of the JSON (recommended for hosting)
GOOGLE_SERVICE_ACCOUNT_JSON=
# ...or a path to the key file instead (local only; never commit the file)
# GOOGLE_APPLICATION_CREDENTIALS=config/service-account.key.json

# ---- Authentication ----
# At least 32 random characters. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
SESSION_HOURS=12
# Users file created by `npm run user:add` (or put the same JSON array in USERS_JSON on hosts without a disk)
USERS_FILE=config/users.json
# USERS_JSON=[{"email":"...","name":"...","role":"admin","passwordHash":"$2a$12$..."}]
# Cookie "Secure" flag. Defaults to true when NODE_ENV=production (requires HTTPS).
# COOKIE_SECURE=true

# Development only: one-click sign-in as PM / editor / client. Ignored when NODE_ENV=production.
ALLOW_DEV_LOGIN=false

# Open access (default true): anyone with the link sees the read-only client view without signing in;
# internal data is still removed on the server, and nobody can edit without a team sign-in.
# With no accounts configured, JWT_SECRET and USERS_JSON are not needed. Set to false to require sign-in.
# PUBLIC_ACCESS=true
